#include <stdio.h>

// Define enumeration
enum Status
{
    SUCCESS,
    FAILURE,
    TIMEOUT
};

int main()
{
    enum Status result;

    // Assign status value
    result = SUCCESS;

    // Check status using switch
    switch (result)
    {
        case SUCCESS:
            printf("Operation completed successfully!\n");
            break;

        case FAILURE:
            printf("Operation failed!\n");
            break;

        case TIMEOUT:
            printf("Operation timed out!\n");
            break;

        default:
            printf("Invalid status!\n");
    }

    return 0;
}